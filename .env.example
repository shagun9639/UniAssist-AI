# ==============================================================================
# UniAssist AI – Environment Configuration Template
# Copy this file to .env or set environment variables before launching services.
# ==============================================================================

# Database Persistence Configuration (Default: MySQL 8)
# If MySQL is not installed locally, set SPRING_PROFILES_ACTIVE=h2 for zero-config in-memory mode
SPRING_PROFILES_ACTIVE=default
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uniassist_db
DB_USERNAME=root
DB_PASSWORD=root

# Spring Boot Backend Gateway Configuration
SERVER_PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Python AI/ML Microservice Integration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000

# Client Frontend Static Host (Optional)
FRONTEND_PORT=3000
